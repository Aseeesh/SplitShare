{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./custom-worker.ts",
  "name": "splitshare",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "alias": {
    "opennext-worker": "./.open-next/worker.js",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker
      // name. Fallback path for the cron wrapper (see custom-worker.ts).
      // https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "splitshare",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "DATABASE_DRIVER": "neon",
    "DATABASE_POOL_MAX": "3",
    "NEXT_PUBLIC_APP_URL": "https://splitshare.ashish-rijal.workers.dev",
    "AUTH_URL": "https://splitshare.ashish-rijal.workers.dev",
    "EMAIL_FROM": "SplitHome <no-reply@sparkclean.co.nz>",
  },
}
